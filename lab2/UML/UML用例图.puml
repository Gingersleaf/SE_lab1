@startuml "用例图 - 多人共享记账系统（账本与记录审核）"
skinparam defaultFontName "Microsoft YaHei"
skinparam backgroundColor #FFFFFF
left to right direction

' 定义参与者
actor 管理员 as Admin
actor 记账成员 as Writer
actor 只读成员 as Reader

' 账本与成员
rectangle "账本与成员" {
    usecase "创建账本" as UC001
    usecase "邀请成员并指定角色" as UC002
    usecase "调整成员角色" as UC003
    usecase "移除成员" as UC004
    usecase "退出账本" as UC005
}

' 记录管理
rectangle "记录管理" {
    usecase "录入记录并存草稿" as UC006
    usecase "编辑草稿" as UC007
    usecase "提交审核" as UC008
    usecase "撤回待审核记录" as UC009
    usecase "多条件查询记录" as UC010
    usecase "查看记录详情与分摊明细" as UC011
}

' 审核与更正
rectangle "审核与更正" {
    usecase "审核通过" as UC012
    usecase "审核驳回" as UC013
    usecase "作废记录" as UC014
    usecase "发起冲正更正" as UC015
}

' 操作日志
rectangle "操作日志" {
    usecase "查询与自己相关的操作日志" as UC016
    usecase "查询全账本操作日志" as UC017
}

' 参与者之间的继承：只读成员的能力是记账成员的子集，记账成员的能力是管理员的子集
Reader --|> Writer : 继承
Writer --|> Admin : 继承

' 只读成员：只能查看
Reader --> UC010
Reader --> UC011

' 记账成员：在只读成员能力之外
Writer --> UC005
Writer --> UC006
Writer --> UC007
Writer --> UC008
Writer --> UC009
Writer --> UC015
Writer --> UC016

' 管理员：在记账成员能力之外
Admin --> UC001
Admin --> UC002
Admin --> UC003
Admin --> UC004
Admin --> UC012
Admin --> UC013
Admin --> UC014
Admin --> UC017

' 定义用例之间的关系
UC002 .> UC001 : 扩展
UC009 .> UC008 : 扩展
UC012 .> UC008 : 扩展
UC013 .> UC008 : 扩展
UC014 .> UC008 : 扩展
UC011 .> UC010 : 扩展
@enduml
